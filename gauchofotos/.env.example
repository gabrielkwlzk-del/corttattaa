# Variáveis de ambiente (Vercel → Project → Settings → Environment Variables)

# Obrigatória. Segredo para assinar sessões e links de download (mín. 32 caracteres). NÃO mude depois de publicado:
# mudar derruba as sessões abertas e invalida links de download ainda não usados.
APP_SECRET=

# Senha do painel. Se vazia, vale a senha inicial embutida (hash). Trocando em Configurações, a nova senha fica no banco.
ADMIN_PASSWORD=

# Banco PostgreSQL — preenchido automaticamente ao conectar o Neon pela aba Storage da Vercel.
DATABASE_URL=

# Armazenamento de fotos — preenchido automaticamente ao conectar um Vercel Blob (privado).
BLOB_READ_WRITE_TOKEN=

# Pix (opcionais)
PIX_KEY=47992145561
PIX_NAME=Esporte Show Online
PIX_CITY=BRASIL

# Limite de tamanho por foto original, em MB (padrão 40)
MAX_UPLOAD_MB=40

# Sites extras permitidos como origem de importação (além de *.netlify.app), separados por vírgula
IMPORT_ALLOWED_HOSTS=
