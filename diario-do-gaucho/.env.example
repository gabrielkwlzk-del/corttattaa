# =====================================================================
#  Diário do Gaúcho — variáveis de ambiente
#  Copie para .env.local (desenvolvimento) ou configure no provedor de
#  hospedagem. NUNCA faça commit de valores reais.
# =====================================================================

# URL pública do site (sem barra no final). Usada no webhook do Pix.
APP_URL=http://localhost:3000

# Segredo para assinar URLs de upload/download. Mínimo 32 caracteres.
# Gere com: openssl rand -base64 48
APP_SECRET=

# ---------------------------------------------------------------------
#  Painel administrativo (/admin)
# ---------------------------------------------------------------------
# Senha inicial definida pelo proprietário na implantação (mín. 8 caracteres).
# No primeiro login ela é convertida em hash scrypt e guardada no banco;
# depois pode ser trocada em /admin/configuracoes.
ADMIN_PASSWORD=
# Alternativa (opcional, tem prioridade): hash pronto gerado por
#   npm run admin:hash -- "sua senha"
# ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------
#  Banco de dados — PostgreSQL / Supabase
# ---------------------------------------------------------------------
# Supabase: Project Settings → Database → Connection string (URI).
# Pode usar o pooler (porta 6543). Em branco = PGlite local em .data/ (apenas desenvolvimento).
DATABASE_URL=
# Aplica as migrations automaticamente ao iniciar (padrão: true).
# AUTO_MIGRATE=true
# DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------
#  Armazenamento de arquivos
# ---------------------------------------------------------------------
# "supabase" (recomendado em produção) ou "local" (disco do servidor).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage

SUPABASE_URL=
# Chave service_role — SOMENTE no servidor, nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ORIGINALS_BUCKET=originals
SUPABASE_PREVIEWS_BUCKET=previews

# Limite por arquivo enviado (MB) e validade dos links de download (segundos).
MAX_UPLOAD_MB=40
DOWNLOAD_URL_TTL_SECONDS=300

# ---------------------------------------------------------------------
#  Pix
# ---------------------------------------------------------------------
# Chave Pix do recebedor (celular 47 99214-5561 → normalizada para +5547992145561).
PIX_KEY=47992145561
# Opcional: força o tipo da chave (phone | cpf | cnpj | email | evp).
PIX_KEY_TYPE=phone
# Obrigatórios para gerar Pix estático (BR Code). Use os dados reais do titular da conta.
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=

# "mercadopago" = cobrança dinâmica com webhook (confirmação automática).
# "static"      = BR Code estático; pedidos ficam pendentes até conferência manual no extrato.
# "none"        = desativa o checkout.
# Em branco: usa mercadopago se MERCADOPAGO_ACCESS_TOKEN estiver definido; senão static.
PIX_PROVIDER=
PIX_EXPIRATION_MINUTES=30

# Mercado Pago (https://www.mercadopago.com.br/developers/panel/app)
# A chave Pix do Mercado Pago deve ser a mesma conta que recebe os pagamentos.
MERCADOPAGO_ACCESS_TOKEN=
# Segredo da assinatura do webhook (Suas integrações → Webhooks → Assinatura secreta).
MERCADOPAGO_WEBHOOK_SECRET=
